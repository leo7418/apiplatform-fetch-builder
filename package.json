{
	"name": "apiplatform-fetch-builder",
	"version": "0.2.0",
	"description": "A TypeScript client for API Platform and Hydra APIs: typed fetch requests with pagination, sorting, filtering and property selection, and typed CRUD services.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leo7418/apiplatform-fetch-builder.git"
	},
	"bugs": {
		"url": "https://github.com/leo7418/apiplatform-fetch-builder/issues"
	},
	"homepage": "https://github.com/leo7418/apiplatform-fetch-builder#readme",
	"keywords": [
		"api",
		"api-platform",
		"apiplatform",
		"hydra",
		"json-ld",
		"fetch",
		"client",
		"typed",
		"typescript"
	],
	"author": "leo7418",
	"license": "MIT",
	"main": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		}
	},
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build:clean": "rm -rf dist",
		"build:setup": "mkdir -p dist && cp package.json dist && cp README.md dist && cp LICENSE dist",
		"build:js": "tsc -p tsconfig.lib.json && find dist/types -type f ! -name '*.ts' -delete",
		"build": "pnpm build:clean && pnpm build:setup && pnpm build:js",
		"typecheck": "tsc --noEmit && tsc -p integration && pnpm build && tsc -p examples/basic && tsc -p examples/entity-service-builder && tsc -p examples/hydra-prefix",
		"lint": "pnpm typecheck && eslint src integration/tests",
		"lint:fix": "eslint src integration/tests --fix",
		"test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test './src/**/*.test.ts'",
		"test:compiled": "rm -rf .test-build && tsc --noEmit false --rootDir src --outDir .test-build && node --test .test-build/lib/*.test.js .test-build/types/*.test.js",
		"test:integration": "integration/run.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.5.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"prettier": "^3.8.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0"
	}
}
